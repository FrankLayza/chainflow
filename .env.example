# Copy to .env.local and fill in. Never commit .env.local.

# --- KeeperHub ---------------------------------------------------------------
# API key from app.keeperhub.com. Grants use of the org's Turnkey wallet.
KEEPERHUB_API_KEY=
# Wallet integration id — GET /api/integrations?type=web3 to find it.
KEEPERHUB_WALLET_INTEGRATION_ID=
# Display-only, shown in the UI top bar.
KEEPERHUB_WALLET_ADDRESS=
# Defaults to Ethereum Sepolia (11155111) when unset.
KEEPERHUB_CHAIN_ID=11155111
# Defaults to https://app.keeperhub.com/mcp when unset.
KEEPERHUB_MCP_ENDPOINT=

# --- Database ----------------------------------------------------------------
# Unset locally -> falls back to file:src/data/chainflow.db.
# Required in production: Vercel's filesystem is read-only, so a file: URL fails.
#   turso db create chainflow && turso db show chainflow --url
TURSO_DATABASE_URL=
#   turso db tokens create chainflow
TURSO_AUTH_TOKEN=

# --- Sessions ----------------------------------------------------------------
# Signs the session cookie that scopes audit rows per browser.
# Required in production; startup throws without it.
#   openssl rand -base64 32
SESSION_SECRET=

# --- AI ----------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
